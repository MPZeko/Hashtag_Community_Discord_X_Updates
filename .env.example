# X API Bearer token (fra et X Developer App-projekt)
X_BEARER_TOKEN=din_bearer_token

# Brugernavn som skal overvåges
X_USERNAME=hashtagutd

# Discord incoming webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Polling interval i sekunder
POLL_INTERVAL_SECONDS=60

# Fil til at gemme sidste sendte tweet-id
STATE_FILE=state.json

# INFO, DEBUG, WARNING...
LOG_LEVEL=INFO
